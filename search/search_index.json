{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u9996\u9801","text":""},{"location":"#welcome-to-13repository-8arms","title":"Welcome to 13Repository | 8ARMS","text":"<p>13\u865f\u5009\u5eab\u63d0\u4f9b\u5c08\u70ba\u7279\u6b8a\u96f6\u7d44\u4ef6\u5b58\u653e\u670d\u52d9  </p> <p>\u53ea\u8ca0\u8cac\u96f6\u4ef6\u4f9b\u7d66\uff0c\u4e0d\u63d0\u4f9b\u6280\u8853\u8a62\u554f\u670d\u52d9</p>"},{"location":"#_1","title":"\u4f7f\u7528\u65b9\u6cd5","text":"<p>\u5b9a\u671f\u66f4\u65b0\u5009\u5eab\u7269\u54c1\u8cc7\u8a0a\u3001\u8207\u5eab\u5b58\u72c0\u614b\uff0c\u521d\u6b21\u4f7f\u7528\u8acb\u6309\u7167\u4e0b\u65b9\u6b65\u9a5f</p> <p>1 \u52a0\u5165\u5009\u5eab\u7ba1\u7406\u54e1LINE\u5e33\u865f - @387uhazm 2 \u8f38\u5165[\u9a57\u8b49\u78bc] - \u9a57\u8b49\u78bc\u8f38\u5165\u5f8c\u7ba1\u7406\u54e1\u63d0\u4f9b\u5c0d\u61c9\u5009\u5eab\u7db2\u5740 3 \u8f38\u5165\u96f6\u4ef6\u7de8\u865f - \u6bcf\u4e00\u9805\u96f6\u4ef6\u90fd\u6709\u7279\u5b9a\u7de8\u865f\uff0c\u63d0\u4f9b\u7de8\u865f\u65b9\u4fbf\u7ba1\u7406\u54e1\u5feb\u901f\u5b9a\u4f4d\u8207\u78ba\u8a8d 4 \u78ba\u8a8d\u5eab\u5b58\u3001\u4ea4\u671f\u60c5\u6cc1 - \u7b49\u5f85\u7ba1\u7406\u54e1\u67e5\u770b\u7cfb\u7d71\uff0c\u78ba\u8a8d\u96f6\u4ef6\u662f\u5426\u5c1a\u6709\u5eab\u5b58\u8207\u51fa\u8ca8\u6642\u9593 5 \u652f\u4ed8\u96f6\u4ef6\u8cbb\u7528 - \u78ba\u8a8d\u5f8c\u63d0\u4f9b\u652f\u4ed8\u622a\u5716\u8cc7\u8a0a\u6216\u532f\u6b3e\u5e33\u865f\u5f8c5\u78bc  </p>"},{"location":"#_2","title":"\u6ce8\u610f\u4e8b\u9805","text":"<p>\u5009\u5eab\u5167\u7686\u70ba\u5ba2\u6236\u66ab\u5b58\u96f6\u4ef6\uff0c\u7576\u6709\u5269\u9918\u5eab\u5b58\u624d\u5141\u8a31\u5c0d\u5916\u4f9b\u7d66 \u5982\u76ee\u524d\u7121\u5eab\u5b58\uff0c\u9700\u7b49\u5f85\u4e0b\u6279\u5165\u5eab\u5f8c\u518d\u767c\u6d88\u606f\u901a\u77e5</p>"},{"location":"%E8%BC%89%E5%85%B7%E9%